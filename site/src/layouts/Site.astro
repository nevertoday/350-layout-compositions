---
// 外壳：和小小东会员站同一套外框（src/data/frame.js）——左边图标导航、顶上栏目标签和右边工具（GitHub、「更多」菜单、下载全部）、
// 正文、页脚。没有站名标志：在哪个栏目看当前的标签。界面全部用 xxd-ui-kit（public/xxd/）。
// 每种语言一套页面：A 是那种语言的数据和界面文字（atlas.js 的 atlasFor），path 是去掉语言前缀的地址（"" 首页、"001/"、"about/"；404 没有），
// tab 是这一页属于哪个栏目（frame.js 的 TABS，404 没有）。
import { readFileSync } from "node:fs";
import { createHash } from "node:crypto";
import { join } from "node:path";
import { REPO_URL, UI_KEYS, atlases } from "../data/atlas.js";
import { TABS, THEMES, VIP, ZIP_URL } from "../data/frame.js";
import { SOURCE } from "../i18n/locales.js";

interface Props {
  A: ReturnType<typeof atlases>[number];
  path?: string; // 不带语言前缀、不带开头斜杠的地址；404 不传
  tab?: "atlas" | "about";
  title?: string;
  description?: string;
  image?: string; // og:image，站内路径
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  expect?: string; // 首帧前要先解析到的元素 id（跨页过渡的目标）
}
const {
  A,
  path,
  tab,
  title,
  description = A.t("site.description"),
  image = "/og-cover.png",
  imageWidth = 1200,
  imageHeight = 630,
  imageAlt,
  expect,
} = Astro.props;
const { locale: loc, t } = A;
const brand = t("site.brand");
const fullTitle = title ? `${title} · ${brand}` : `${brand} · ${t("site.tagline")}`;
const resolvedImageAlt = imageAlt ?? fullTitle;
const all = atlases();
// 404 页没有自己的地址：不写 canonical、og:url、hreflang；语言菜单指向各语言的首页
const abs = (p: string) => new URL(p, Astro.site).href;
const canonical = path === undefined ? undefined : abs(loc.base + path);
const versions = all.map((a) => ({ loc: a.locale, href: a.locale.base + (path ?? "") }));
const ogImage = abs(image);
const ogLocale = (lang: string) => ({
  "zh-CN": "zh_CN", "zh-Hant": "zh_TW", en: "en_US", ja: "ja_JP", ko: "ko_KR",
  es: "es_ES", fr: "fr_FR", de: "de_DE", pt: "pt_BR", ru: "ru_RU", ar: "ar_AR",
}[lang] ?? lang.replace("-", "_"));
const license = `https://creativecommons.org/licenses/by/4.0/deed.${loc.cc}`;
// 浏览器里要用的界面文字（键以 js. 开头的那些）和这种语言的首页地址
const json = (x: unknown) => JSON.stringify(x).replace(/</g, "\\u003c");
const client = { base: loc.base, t: Object.fromEntries(UI_KEYS.filter((k) => k.startsWith("js.")).map((k) => [k.slice(3), t(k)])) };
// 简体中文首页：访客的浏览器语言（或者选过的语言）是另一种我们有的语言时，用那种语言提示一句，不自动跳
const offers = loc === SOURCE && path === ""
  ? Object.fromEntries(all.filter((a) => a.locale !== SOURCE).map((a) => [a.locale.code, {
      href: a.locale.base, lang: a.locale.lang, dir: a.locale.dir,
      text: a.t("site.lang.suggest", { language: a.locale.name }), action: a.t("site.lang.switch", { language: a.locale.name }), close: a.t("site.close"),
    }]))
  : undefined;
// 当前栏目：正是那一页时 aria-current="page"，栏目下面的页（详情）是 "true"
const tabState = (x: (typeof TABS)[number]) => (x.key !== tab ? undefined : path === x.path ? "page" : "true");
// 静态文件带内容指纹（?v=）：改了就换地址
const ver = (f: string) => createHash("sha256").update(readFileSync(join(process.cwd(), "public", f))).digest("hex").slice(0, 10);
const asset = (f: string) => `/${f}?v=${ver(f)}`;
const svg = (body: string, size = 20) => `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="miter" aria-hidden="true" focusable="false">${body}</svg>`;
// 会员站顶栏的 GitHub 标志（描边版）
const GITHUB_MARK = svg('<path d="M15 22v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 19 4.77 5.07 5.07 0 0 0 18.91 1S17.73.65 15 2.48a13.38 13.38 0 0 0-7 0C5.27.65 4.09 1 4.09 1A5.07 5.07 0 0 0 4 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 8 18.13V22"/><path d="M8 19c-3 .9-5.5 0-7-2"/>', 18);
const langItems = (id: string) => versions.map((v) => (
  { id, href: v.href, code: v.loc.code, lang: v.loc.lang, dir: v.loc.dir, name: v.loc.name, on: v.loc === loc }
));
---

<!doctype html>
<html lang={loc.lang} dir={loc.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#fdfcfb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171612" media="(prefers-color-scheme: dark)" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && versions.map((v) => <link rel="alternate" hreflang={v.loc.lang} href={abs(v.href)} />)}
    {canonical && <link rel="alternate" hreflang="x-default" href={abs(SOURCE.base + path)} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand} />
    <meta property="og:locale" content={ogLocale(loc.lang)} />
    {versions.filter((v) => v.loc !== loc).map((v) => <meta property="og:locale:alternate" content={ogLocale(v.loc.lang)} />)}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={resolvedImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {expect && <link rel="expect" href={`#${expect}`} blocking="render" />}
    <style is:inline>@layer theme, base, xxd, components, utilities, site;</style>
    <script is:inline src={asset("xxd/boot.js")} data-key="xxd-layout-site" data-default-theme="system"></script>
    <link rel="stylesheet" href={asset("xxd/xxd.css")} />
    <link rel="stylesheet" href={asset("site.css")} />
    <script is:inline src={asset("xxd/icons.js")}></script>
    <script is:inline src={asset("xxd/xxd.js")}></script>
    <slot name="head" />
  </head>
  <body class="xxd-page">
    <a class="xxd-sr-only-focusable" href="#main">{t("site.skip")}</a>
    <header class="frame-head">
      <nav class="frame-tabs" aria-label={t("frame.tabs")}>
        {TABS.map((x) => x.href
          ? <a class="frame-tab" href={x.href} target="_blank" rel="noopener">{t(x.label)}<i data-xxd-icon="ArrowUpRight" data-size="12"></i></a>
          : <a class="frame-tab" href={loc.base + x.path} aria-current={tabState(x)}><i class="frame-tab__mark" data-xxd-icon="Navigation" data-size="14"></i>{t(x.label)}</a>)}
      </nav>
      <div class="frame-tools">
        <a class="frame-icon-btn frame-wide" href={REPO_URL} target="_blank" rel="noopener" aria-label={t("frame.github")} data-tooltip={t("frame.github")} data-tooltip-placement="bottom" set:html={GITHUB_MARK} />
        <button class="frame-icon-btn" type="button" id="frame-more-btn" data-xxd-menu="frame-more" aria-label={t("frame.more")} data-tooltip={t("frame.more")} data-tooltip-placement="bottom"><i data-xxd-icon="Ellipsis" data-size="18"></i></button>
        <div class="xxd-menu frame-menu" id="frame-more" role="menu" popover data-placement="bottom-end">
          <div class="xxd-menu__label" id="frame-theme-label">{t("frame.theme")}</div>
          <div role="group" aria-labelledby="frame-theme-label" id="frame-theme">
            {THEMES.map((x) => <button class="xxd-menu__item" type="button" role="menuitemradio" aria-checked="false" data-value={x.value}>{t(x.label)}</button>)}
          </div>
          {versions.length > 1 && (
            <>
              <div class="xxd-menu__sep" role="separator"></div>
              <button class="xxd-menu__item" type="button" role="menuitem" data-submenu="frame-langs" aria-haspopup="menu"><i data-xxd-icon="Languages" data-size="14"></i>{t("site.lang")}<span class="xxd-menu__kbd">{loc.name}</span></button>
              <div class="xxd-menu frame-langs" id="frame-langs" role="menu" popover="manual">
                {langItems("frame-langs").map((v) => <a class="xxd-menu__item" role="menuitemradio" aria-checked={String(v.on)} href={v.href} hreflang={v.lang} data-lang={v.code}><span lang={v.lang} dir={v.dir}>{v.name}</span></a>)}
              </div>
            </>
          )}
          <div class="frame-narrow">
            <div class="xxd-menu__sep" role="separator"></div>
            <a class="xxd-menu__item" role="menuitem" href={ZIP_URL}><i data-xxd-icon="Download" data-size="14"></i>{t("frame.download")}</a>
          </div>
        </div>
        <a class="xxd-btn frame-wide" data-variant="primary" href={ZIP_URL} data-tooltip={t("frame.downloadTip")} data-tooltip-placement="bottom-end">{t("frame.download")}</a>
      </div>
    </header>

    <main id="main" class="site-main">
      {offers && (
        <div class="xxd-banner site-lang-banner" role="status" id="lang-banner" hidden>
          <i data-xxd-icon="Languages"></i>
          <p class="xxd-banner__title" id="lang-banner-text"></p>
          <div class="xxd-banner__actions"><a class="xxd-btn" data-size="sm" id="lang-banner-go" href="/"></a></div>
          <button class="xxd-btn xxd-banner__close" data-variant="ghost" data-icon-only data-size="xs" type="button" data-banner-close id="lang-banner-close"><i data-xxd-icon="X" data-size="14"></i></button>
        </div>
        <script is:inline type="application/json" id="lang-offers" set:html={json(offers)} />
        <script is:inline>
          // 在首帧之前决定要不要出横幅（不跳动）。选过语言（xxd-layout-lang）就按选的；没选过看浏览器的语言里第一个我们有的，是中文就不提示。关掉过的那种语言不再提示
          (() => {
            const offers = JSON.parse(document.getElementById("lang-offers").textContent);
            const get = (k) => { try { return localStorage.getItem(k); } catch { return null; } };
            const set = (k, v) => { try { localStorage.setItem(k, v); } catch {} };
            const codeOf = (tag) => { const t = String(tag).toLowerCase(); return /^zh-(hant|tw|hk|mo)\b/.test(t) ? "zh-Hant" : t.split("-")[0]; };
            let want = get("xxd-layout-lang");
            if (!want) for (const tag of navigator.languages || [navigator.language]) { const c = codeOf(tag); if (c === "zh" || offers[c]) { want = c; break; } }
            const o = offers[want];
            if (!o || get("xxd-layout-lang-banner") === want) return;
            const banner = document.getElementById("lang-banner");
            const go = document.getElementById("lang-banner-go");
            banner.lang = o.lang;
            banner.dir = o.dir;
            document.getElementById("lang-banner-text").textContent = o.text;
            go.textContent = o.action;
            go.href = o.href;
            go.addEventListener("click", () => set("xxd-layout-lang", want));
            const close = document.getElementById("lang-banner-close");
            close.setAttribute("aria-label", o.close);
            close.addEventListener("click", () => set("xxd-layout-lang-banner", want));
            banner.hidden = false;
          })();
        </script>
      )}
      <slot />
    </main>

    <footer class="frame-foot">
      <p class="frame-foot__meta"><span>© 2026 xiaoxiaodong.ai</span><span aria-hidden="true">·</span><a href={license}>{t("frame.footer.license")}</a></p>
      <nav class="frame-foot__nav" aria-label={brand}>
        <a href={`${loc.base}about/`}>{t("frame.tab.about")}</a>
        <a href={`${REPO_URL}/issues`}>{t("frame.footer.issues")}</a>
        <a href={`${VIP}/`}>{t("frame.footer.vip")}</a>
        {versions.length > 1 && (
          <>
            <button type="button" data-xxd-menu="foot-langs" aria-label={`${t("site.lang")} · ${loc.name}`}>{loc.name}<i data-xxd-icon="ChevronDown" data-size="12"></i></button>
            <div class="xxd-menu frame-langs" id="foot-langs" role="menu" popover data-placement="top-end">
              {langItems("foot-langs").map((v) => <a class="xxd-menu__item" role="menuitemradio" aria-checked={String(v.on)} href={v.href} hreflang={v.lang} data-lang={v.code}><span lang={v.lang} dir={v.dir}>{v.name}</span></a>)}
            </div>
          </>
        )}
      </nav>
    </footer>

    <script is:inline type="application/json" id="site-ui" set:html={json(client)} />
    <script is:inline data-carry={path === "" ? "" : undefined} id="frame-script">
      (() => {
        // 外观：「更多」菜单里的亮 / 暗 / 跟随系统，存在 xxd 的外观设置里（boot.js 在首帧前按它上色）
        const theme = document.getElementById("frame-theme");
        const look = window.XxdTheme;
        const mark = () => {
          const now = look?.read?.()?.theme || "system";
          for (const b of theme.querySelectorAll("[data-value]")) b.setAttribute("aria-checked", String(b.dataset.value === now));
        };
        theme.addEventListener("xxd:change", (e) => { look?.set({ theme: e.detail.value }); mark(); });
        addEventListener("xxd:settings", mark);
        mark();
        // 选了语言就记下来（简体中文首页的横幅按它提示）；在图鉴页切语言时带上分类、主题、收藏（搜索词是这种语言的字，不带）
        const carry = document.getElementById("frame-script").hasAttribute("data-carry");
        document.addEventListener("click", (e) => {
          const a = e.target.closest?.("a[data-lang]");
          if (!a) return;
          try { localStorage.setItem("xxd-layout-lang", a.dataset.lang); } catch {}
          if (!carry) return;
          const p = new URLSearchParams(location.search);
          p.delete("q");
          a.search = p.toString();
        }, true);
      })();
    </script>
  </body>
</html>
