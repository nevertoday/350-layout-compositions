---
// 外壳：顶栏（标志 + 站名、搜索、关于与下载、语言、外观、GitHub）、正文、页脚。界面全部用 xxd-ui-kit（public/xxd/）。
// 每种语言一套页面：A 是那种语言的数据和界面文字（atlas.js 的 atlasFor），path 是去掉语言前缀的地址（"" 首页、"001/"、"about/"；404 没有）。
// 顶栏的搜索是一个 GET 表单：在图鉴页边打边筛（atlas-page.js 接管），在别的页面回车跳到这种语言的首页 ?q=。
import { readFileSync } from "node:fs";
import { createHash } from "node:crypto";
import { join } from "node:path";
import { REPO_URL, UI_KEYS, atlases } from "../data/atlas.js";
import { SOURCE } from "../i18n/locales.js";

interface Props {
  A: ReturnType<typeof atlases>[number];
  path?: string; // 不带语言前缀、不带开头斜杠的地址；404 不传
  title?: string;
  description?: string;
  image?: string; // og:image，站内路径
  expect?: string; // 首帧前要先解析到的元素 id（跨页过渡的目标）
}
const { A, path, title, description = A.t("site.description"), image = A.layouts[0].img.full, expect } = Astro.props;
const { locale: loc, t } = A;
const brand = t("site.brand");
const fullTitle = title ? `${title} · ${brand}` : `${brand} · ${t("site.tagline")}`;
const all = atlases();
// 404 页没有自己的地址：不写 canonical、og:url、hreflang；语言菜单指向各语言的首页
const abs = (p: string) => new URL(p, Astro.site).href;
const canonical = path === undefined ? undefined : abs(loc.base + path);
const versions = all.map((a) => ({ loc: a.locale, href: a.locale.base + (path ?? "") }));
const ogImage = abs(image);
const license = `https://creativecommons.org/licenses/by/4.0/deed.${loc.cc}`;
// 浏览器里要用的界面文字（键以 js. 开头的那些）和这种语言的首页地址
const json = (x: unknown) => JSON.stringify(x).replace(/</g, "\\u003c");
const client = { base: loc.base, t: Object.fromEntries(UI_KEYS.filter((k) => k.startsWith("js.")).map((k) => [k.slice(3), t(k)])) };
// 简体中文首页：访客的浏览器语言（或者选过的语言）是另一种我们有的语言时，用那种语言提示一句，不自动跳
const offers = loc === SOURCE && path === ""
  ? Object.fromEntries(all.filter((a) => a.locale !== SOURCE).map((a) => [a.locale.code, {
      href: a.locale.base, lang: a.locale.lang, dir: a.locale.dir,
      text: a.t("site.lang.suggest", { language: a.locale.name }), action: a.t("site.lang.switch", { language: a.locale.name }), close: a.t("site.close"),
    }]))
  : undefined;
// 静态文件带内容指纹（?v=）：改了就换地址
const ver = (f: string) => createHash("sha256").update(readFileSync(join(process.cwd(), "public", f))).digest("hex").slice(0, 10);
const asset = (f: string) => `/${f}?v=${ver(f)}`;
const GITHUB_MARK = '<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false"><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/></svg>';
---

<!doctype html>
<html lang={loc.lang} dir={loc.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && versions.map((v) => <link rel="alternate" hreflang={v.loc.lang} href={abs(v.href)} />)}
    {canonical && <link rel="alternate" hreflang="x-default" href={abs(SOURCE.base + path)} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {expect && <link rel="expect" href={`#${expect}`} blocking="render" />}
    <style is:inline>@layer theme, base, xxd, components, utilities, site;</style>
    <script is:inline src={asset("xxd/boot.js")} data-key="xxd-layout-site" data-default-theme="system"></script>
    <script is:inline>try { document.documentElement.dataset.grid = localStorage.getItem("xxd-layout-grid") || "m"; } catch { document.documentElement.dataset.grid = "m"; }</script>
    <link rel="stylesheet" href={asset("xxd/xxd.css")} />
    <link rel="stylesheet" href={asset("site.css")} />
    <script is:inline src={asset("xxd/icons.js")}></script>
    <script is:inline src={asset("xxd/xxd.js")}></script>
    <slot name="head" />
  </head>
  <body class="xxd-page">
    <a class="xxd-sr-only-focusable" href="#main">{t("site.skip")}</a>
    <header class="xxd-topbar site-top">
      <a class="xxd-logo site-brand" href={loc.base} aria-label={t("site.home", { brand })}><span class="xxd-logo__mark" aria-hidden="true"></span><span class="site-brand__name">{brand}</span></a>
      <form class="site-search" action={loc.base} method="get" role="search" id="site-search">
        <div class="xxd-input-wrap">
          <i data-xxd-icon="Search" data-size="16"></i>
          <input class="xxd-input" type="search" name="q" id="site-q" placeholder={t("site.search.placeholder")} aria-label={t("site.search.label")} autocomplete="off" enterkeyhint="search" />
          <button class="xxd-input-clear" type="button" aria-label={t("site.search.clear")}><i data-xxd-icon="X" data-size="14"></i></button>
        </div>
      </form>
      <div class="site-tools">
        <a class="xxd-btn site-about" data-size="sm" data-variant="ghost" href={`${loc.base}about/`} aria-current={path === "about/" ? "page" : undefined}><span class="site-about__short">{t("site.about")}</span><span class="site-about__full">{t("site.aboutFull")}</span></a>
        <button class="xxd-btn site-lang" data-size="sm" data-variant="ghost" type="button" data-xxd-menu="site-langs" aria-label={`${t("site.lang")} · ${loc.name}`}>
          <i data-xxd-icon="Languages" data-size="16"></i><span class="site-lang__name">{loc.name}</span>
        </button>
        <div class="xxd-menu site-langs" id="site-langs" role="menu" popover data-placement="bottom-end" data-carry={path === "" ? "" : undefined}>
          {versions.map((v) => (
            <a class="xxd-menu__item" role="menuitemradio" aria-checked={String(v.loc === loc)} href={v.href} hreflang={v.loc.lang} lang={v.loc.lang} dir={v.loc.dir} data-lang={v.loc.code}>{v.loc.name}</a>
          ))}
        </div>
        <button class="xxd-btn xxd-appearance-btn" data-size="sm" data-variant="ghost" data-icon-only type="button" data-xxd-popover="site-look" aria-label={t("site.appearance")} data-tooltip={t("site.appearance")} data-tooltip-placement="bottom">
          <i class="xxd-appearance-btn__sun" data-xxd-icon="Sun" data-size="16"></i>
          <i class="xxd-appearance-btn__moon" data-xxd-icon="Moon" data-size="16"></i>
        </button>
        <div class="xxd-popover xxd-appearance-pop" id="site-look" popover data-placement="bottom-end"></div>
        <a class="xxd-btn site-gh" data-size="sm" data-variant="ghost" data-icon-only href={REPO_URL} aria-label={t("site.github")} data-tooltip={t("site.github")} data-tooltip-placement="bottom-end" set:html={GITHUB_MARK} />
      </div>
    </header>

    <main id="main" class="site-main">
      {offers && (
        <div class="xxd-banner site-lang-banner" role="status" id="lang-banner" hidden>
          <i data-xxd-icon="Languages"></i>
          <p class="xxd-banner__title" id="lang-banner-text"></p>
          <div class="xxd-banner__actions"><a class="xxd-btn" data-size="sm" id="lang-banner-go" href="/"></a></div>
          <button class="xxd-btn xxd-banner__close" data-variant="ghost" data-icon-only data-size="xs" type="button" data-banner-close id="lang-banner-close"><i data-xxd-icon="X" data-size="14"></i></button>
        </div>
        <script is:inline type="application/json" id="lang-offers" set:html={json(offers)} />
        <script is:inline>
          // 在首帧之前决定要不要出横幅（不跳动）。选过语言（xxd-layout-lang）就按选的；没选过看浏览器的语言里第一个我们有的，是中文就不提示。关掉过的那种语言不再提示
          (() => {
            const offers = JSON.parse(document.getElementById("lang-offers").textContent);
            const get = (k) => { try { return localStorage.getItem(k); } catch { return null; } };
            const set = (k, v) => { try { localStorage.setItem(k, v); } catch {} };
            const codeOf = (tag) => { const t = String(tag).toLowerCase(); return /^zh-(hant|tw|hk|mo)\b/.test(t) ? "zh-Hant" : t.split("-")[0]; };
            let want = get("xxd-layout-lang");
            if (!want) for (const tag of navigator.languages || [navigator.language]) { const c = codeOf(tag); if (c === "zh" || offers[c]) { want = c; break; } }
            const o = offers[want];
            if (!o || get("xxd-layout-lang-banner") === want) return;
            const banner = document.getElementById("lang-banner");
            const go = document.getElementById("lang-banner-go");
            banner.lang = o.lang;
            banner.dir = o.dir;
            document.getElementById("lang-banner-text").textContent = o.text;
            go.textContent = o.action;
            go.href = o.href;
            go.addEventListener("click", () => set("xxd-layout-lang", want));
            const close = document.getElementById("lang-banner-close");
            close.setAttribute("aria-label", o.close);
            close.addEventListener("click", () => set("xxd-layout-lang-banner", want));
            banner.hidden = false;
          })();
        </script>
      )}
      <slot />
    </main>
    <footer class="site-foot">
      <p set:html={t("site.footer", { license, repo: REPO_URL, vip: "https://vip.xiaoxiaodong.ai/" })} />
    </footer>

    <script is:inline type="application/json" id="site-ui" set:html={json(client)} />
    <script is:inline>
      (() => {
        const X = window.Xxd;
        if (!X) return;
        const ui = JSON.parse(document.getElementById("site-ui").textContent);
        const labels = Object.fromEntries(Object.entries(ui.t).filter(([k]) => k.startsWith("appearance.")).map(([k, v]) => [k.slice(11), v]));
        X.mountAppearance(document.getElementById("site-look"), { lockCorners: true, labels });
        // 不在图鉴页时，搜索框回车就是普通的 GET <首页>?q=；空着回车不跳
        const form = document.getElementById("site-search");
        const input = document.getElementById("site-q");
        form.addEventListener("submit", (e) => { if (!input.value.trim()) e.preventDefault(); });
        if (location.pathname !== ui.base) X.bindSearch(input, { hotkey: false });
        // 选了语言就记下来（简体中文首页的横幅按它提示）；在图鉴页切语言时带上分类、主题、收藏（搜索词是这种语言的字，不带）
        const langs = document.getElementById("site-langs");
        langs.addEventListener("click", (e) => {
          const a = e.target.closest("[data-lang]");
          if (!a) return;
          try { localStorage.setItem("xxd-layout-lang", a.dataset.lang); } catch {}
          if (!langs.hasAttribute("data-carry")) return;
          const p = new URLSearchParams(location.search);
          p.delete("q");
          a.search = p.toString();
        });
      })();
    </script>
  </body>
</html>
