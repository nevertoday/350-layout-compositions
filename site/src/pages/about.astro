---
// 关于与下载：这是什么、怎么用、下载、署名、联系。
import Site from "../layouts/Site.astro";
import { REPO_URL, categories, stats } from "../data/atlas.js";

const ZIP = `${REPO_URL}/releases/latest/download/350-layout-compositions-images.zip`;
const ZIP_CLASSIC = `${REPO_URL}/releases/latest/download/100-layout-compositions-images.zip`;
const CREDIT = `图片来自「350 种排版」（小小东，${REPO_URL}），CC BY 4.0`;
---
<Site title="关于与下载" description="350 种排版是什么、怎么用；下载全部高清图和数据目录；CC BY 4.0 署名写法。">
  <article class="xxd-prose about">
    <h1>关于与下载</h1>
    <p class="about-lead">350 张排版和构图教学海报，每张讲一种版式：它是什么、要点在哪、什么时候用。按 {stats.categories} 个分类、{stats.subs} 个主题排好，可以搜、可以下载、可以直接拿去作图。</p>

    <h2>怎么用</h2>
    <ol>
      <li>在<a href="/">图鉴</a>里点分类标签，或者在顶上的搜索框打字：名称、编号、英文名、要点、关键词都能搜。</li>
      <li>点开一张看大图；点图看原尺寸，海报上的小字也看得清。有第二版的可以切换。</li>
      <li><strong>下载高清图</strong>（WebP，1086 × 1448），或者<strong>复制构图提示词</strong>：一段话写清这种构图，贴在你的作图提示词末尾。</li>
      <li>做项目时先<strong>收藏</strong>几种候选，在图鉴的「收藏」里一键复制清单（编号 + 名称）。收藏只存在这个浏览器里。</li>
    </ol>

    <h2>八个分类</h2>
    <ul class="about-cats">
      {categories.map((c) => <li><a href={`/?c=${c.slug}`}>{c.no} {c.name}</a><span>{c.count} 种 · {c.range}</span></li>)}
    </ul>

    <h2>下载</h2>
    <ul>
      <li><a href={ZIP}>全部 350 张高清图（ZIP）</a>：原始 PNG，GitHub Release 附件。</li>
      <li><a href={ZIP_CLASSIC}>经典版 100 张（ZIP）</a>：原来的「100 种排版」。</li>
      <li>数据目录：<a href={`${REPO_URL}/blob/main/v2/catalog.csv`}>CSV</a>（表格软件直接打开）· <a href={`${REPO_URL}/blob/main/v2/catalog.json`}>JSON</a>（给程序用）。字段有编号、名称、分类、主题、图片路径、尺寸和 SHA-256。</li>
    </ul>

    <h2>授权与署名</h2>
    <p>图片和数据按 <a href="https://creativecommons.org/licenses/by/4.0/deed.zh-hans">CC BY 4.0</a> 授权：可以转载、分享、改编，商用也可以，要署名并注明是否改动过。署名可以这样写：</p>
    <div class="about-credit">
      <p>{CREDIT}</p>
      <button class="xxd-btn" data-size="sm" type="button" data-copy={CREDIT} data-copy-done="已复制"><i data-xxd-icon="Copy" data-size="16"></i>复制署名</button>
    </div>

    <h2>海报上的文字</h2>
    <p>详情页的定义、要点、用法和关键词是从海报上抄下来的：两个模型各抄一遍，逐字段比对，对不上的人工看过。只抄写，不补写。发现抄错了，请到 <a href={`${REPO_URL}/issues`}>GitHub Issues</a> 说一声。</p>

    <h2>小小东</h2>
    <ul>
      <li>源码和问题反馈：<a href={REPO_URL}>GitHub · nevertoday/350-layout-compositions</a></li>
      <li>会员站：<a href="https://vip.xiaoxiaodong.ai/">小小东成员提示词库</a></li>
      <li>联系作者：<a href="https://x.com/xiaoxiaodong01">X · @xiaoxiaodong01</a></li>
    </ul>
  </article>
</Site>
