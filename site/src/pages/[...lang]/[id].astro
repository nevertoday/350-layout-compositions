---
// 详情页：左边大图（点开看原尺寸，有第二版的可以切换），右边编号、名称（下面是海报上的中文原名和英文名）、定义、要点、用法、关键词和操作；
// ← → 翻上一张 / 下一张（从右往左的语言反过来）；下面列同主题。没有释文的只是少几段字，页面照常。每种语言一页（简体中文在 /<编号>/）。
import Site from "../../layouts/Site.astro";
import Card from "../../components/Card.astro";
import { atlases } from "../../data/atlas.js";
import { SOURCE } from "../../i18n/locales.js";

export function getStaticPaths() {
  return atlases().flatMap((A) => A.layouts.map((l) => ({ params: { lang: A.locale.path || undefined, id: l.id }, props: { A } })));
}
const { A } = Astro.props;
const { t, locale: loc } = A;
const base = loc.base;
const l = A.layoutById.get(Astro.params.id!)!;
const cat = A.categoryBySlug.get(l.cat)!;
const sub = cat.subs.find((s) => s.slug === l.sub)!;
const prev = l.prev ? A.layoutById.get(l.prev) : undefined;
const next = l.next ? A.layoutById.get(l.next) : undefined;
// 文字不是页面语言的（译文缺的，用的中文）写上它的语言
const L = (x: { lang: string }) => (x.lang === loc.lang ? undefined : x.lang);
const T = L(l);
// 标签页标题、读屏名字、图片说明里的名称：这一种还没有译文时用海报英文名，没有英文名就只用编号（这些地方标不了语言）
const label = T ? l.nameEn || l.id : l.name;
const safe = (s: string) => s.replace(/[\\/:*?"<>|]+/g, " ").trim();
const versions = [l.img, ...(l.second ? [l.second] : [])].map((v, i) => ({
  ...v,
  label: t(i ? "detail.v2" : "detail.v1"),
  file: `${l.id}-${safe(label)}${i ? `-${safe(t("detail.v2"))}` : ""}.webp`,
}));
// 名称下面一行：名称是中文的（简体中文页、还没有译文的）写海报英文名；别的写海报上的中文原名和英文名（英文页的名称就是英文名，只写中文）
const zhName = l.lang === SOURCE.lang;
const orig = [{ text: l.nameZh, lang: SOURCE.lang }, ...(l.nameEn && l.nameEn !== l.name ? [{ text: l.nameEn, lang: "en" }] : [])];
// 海报英文小字和这一条的字一样时（英文页的关键词）不重复
const extra = (en: string, text: string) => (en && en.toLowerCase() !== text.toLowerCase() ? en : "");
const named = l.nameEn && l.nameEn !== l.name ? t("detail.nameWithEn", { name: l.name, en: l.nameEn }) : l.name;
const description = l.summary
  ? t("detail.meta", { name: named, summary: l.summary })
  : t("detail.metaNoText", { name: l.name, brand: t("site.brand"), id: l.id, cat: cat.name, sub: sub.name });
const link = new URL(`${base}${l.id}/`, Astro.site).href;
const viewer = { name: label, versions: versions.map((v) => ({ src: v.full, thumb: v.thumb, png: v.png, label: v.label, file: v.file })) };
const kbd = '<kbd class="xxd-kbd">←</kbd> <kbd class="xxd-kbd">→</kbd>';
---
<Site A={A} path={`${l.id}/`} tab="atlas" title={label === l.id ? label : `${l.id} ${label}`} description={description} image={l.img.full} expect="poster">
  <article class="detail" data-id={l.id}>
    <div class="detail-main">
      <nav class="detail-crumbs" aria-label={t("detail.crumbs")}>
        <ol class="xxd-breadcrumbs">
          <li><a href={`${base}#atlas`}>{t("frame.tab.atlas")}</a></li>
          <li lang={L(cat)}><a href={`${base}?c=${cat.slug}#atlas`}>{cat.name}</a></li>
          <li lang={L(sub)}><a href={`${base}?c=${cat.slug}&s=${sub.slug}#atlas`}>{sub.name}</a></li>
        </ol>
      </nav>
      <figure class="detail-poster">
        <button class="detail-poster__open" type="button" id="poster-open" aria-label={t("detail.open", { name: label })}>
          <img id="poster" src={l.img.full} width={l.img.w} height={l.img.h} alt={t("js.poster.alt", { name: label })} fetchpriority="high" decoding="async" style={`--thumb: url("${l.img.thumb}")`} />
          <span class="detail-poster__hint" aria-hidden="true"><i data-xxd-icon="ZoomIn" data-size="16"></i>{t("js.viewer.actual")}</span>
        </button>
        {l.second && (
          <figcaption class="detail-poster__versions">
            <div class="xxd-segmented" data-xxd-segmented aria-label={t("detail.versions")} id="poster-version">
              {versions.map((v, i) => <button role="radio" data-value={String(i)} aria-checked={String(i === 0)}>{v.label}</button>)}
            </div>
            <span>{t("detail.twoNote")}</span>
          </figcaption>
        )}
      </figure>

      <div class="detail-info">
        <p class="detail-no">{t("detail.no", { id: l.id })}</p>
        <h1 lang={T}>{l.name}</h1>
        {zhName
          ? l.nameEn && <p class="detail-en" lang="en">{l.nameEn}</p>
          : <p class="detail-en"><span class="detail-en__label">{t("detail.onPoster")}</span>{orig.map((o) => <span lang={o.lang}>{o.text}</span>)}</p>}

        <div class="detail-actions">
          <a class="xxd-btn" data-variant="primary" href={l.img.full} download={versions[0].file} id="dl"><i data-xxd-icon="Download" data-size="16"></i>{t("detail.download")}</a>
          <button class="xxd-btn" type="button" data-copy={l.prompt} data-copy-done={t("detail.copied")} data-copy-toast={t("detail.copiedPrompt")}><i data-xxd-icon="Copy" data-size="16"></i>{t("detail.copyPrompt")}</button>
          <button class="xxd-btn detail-fav" type="button" data-fav={l.id} aria-pressed="false"><i data-xxd-icon="Star" data-size="16"></i><span data-fav-label>{t("js.fav")}</span></button>
          <button class="xxd-btn" type="button" data-icon-only data-copy={link} data-copy-done={t("detail.copiedLink")} aria-label={t("detail.copyLink")} data-tooltip={t("detail.copyLink")}><i data-xxd-icon="Link" data-size="16"></i></button>
        </div>
        <p class="detail-files">WebP · {l.img.w} × {l.img.h} · <a href={l.img.png} id="png">{t("detail.png")}</a></p>

        {l.summary && (
          <section class="detail-sec">
            <h2>{t("detail.summary")}</h2>
            <p class="detail-summary" lang={T}>{l.summary}</p>
          </section>
        )}
        {l.points.length > 0 && (
          <section class="detail-sec">
            <h2>{t("detail.points")}</h2>
            <ol class="detail-points" lang={T}>
              {l.points.map((p) => (
                <li>
                  <p class="detail-points__title">{p.title}{extra(p.en, p.title) && <span lang="en">{p.en}</span>}</p>
                  {p.body && <p>{p.body}</p>}
                </li>
              ))}
            </ol>
          </section>
        )}
        {l.usage.items.length > 0 && (
          <section class="detail-sec">
            {l.usage.title ? <h2 lang={T}>{l.usage.title}</h2> : <h2>{t("detail.usage")}</h2>}
            <ul class="detail-usage" lang={T}>{l.usage.items.map((u) => <li>{u}</li>)}</ul>
          </section>
        )}
        {l.notes.length > 0 && (
          <section class="detail-sec">
            <h2>{t("detail.notes")}</h2>
            {l.notes.map((n) => <p lang={T}>{n}</p>)}
          </section>
        )}
        {l.keywords.length > 0 && (
          <section class="detail-sec">
            <h2>{t("detail.keywords")}</h2>
            <ul class="detail-keys" role="list" lang={T}>
              {l.keywords.map((k) => <li><a class="xxd-chip" href={`${base}?q=${encodeURIComponent(k.term || k.en)}#atlas`}>{k.term}{extra(k.en, k.term) && <span lang="en">{k.en}</span>}</a></li>)}
            </ul>
          </section>
        )}
        <section class="detail-sec">
          <h2>{t("detail.prompt")}</h2>
          <p class="detail-prompt" lang={T}>{l.prompt}</p>
        </section>

        <nav class="detail-pn" aria-label={t("detail.pn")}>
          {prev ? <a rel="prev" href={`${base}${prev.id}/`}><span class="detail-pn__dir"><i data-xxd-icon="ArrowLeft" data-size="14"></i>{t("detail.prev")} · {prev.id}</span><span class="detail-pn__name" lang={L(prev)}>{prev.name}</span></a> : <span></span>}
          {next ? <a rel="next" href={`${base}${next.id}/`}><span class="detail-pn__dir">{next.id} · {t("detail.next")}<i data-xxd-icon="ArrowRight" data-size="14"></i></span><span class="detail-pn__name" lang={L(next)}>{next.name}</span></a> : <span></span>}
        </nav>
        <p class="detail-keyhint" set:html={t("detail.keys", { keys: kbd })} />
      </div>
    </div>

    <section class="detail-related" aria-labelledby="related-title">
      <p class="eyebrow">{t("detail.related")}</p>
      <h2 id="related-title" lang={L(sub)}>{sub.name}</h2>
      {sub.blurb && <p class="detail-related__lead" lang={L(sub)}>{sub.blurb}</p>}
      <ul class="related-cards" role="list">
        {sub.ids.map((id) => <Card A={A} l={A.layoutById.get(id)!} current={id === l.id} />)}
      </ul>
    </section>
  </article>
  <script type="application/json" id="detail-data" set:html={JSON.stringify(viewer).replace(/</g, "\\u003c")} />
  <script src="../../scripts/detail-page.js"></script>
</Site>
