---
// 关于与下载：这是什么、怎么用、下载、署名、联系。每种语言一页（简体中文在 /about/）；译出来的语言多一句「这是 AI 翻译的」。
import Site from "../../layouts/Site.astro";
import { REPO_URL, atlases } from "../../data/atlas.js";
import { SOURCE } from "../../i18n/locales.js";

export function getStaticPaths() {
  return atlases().map((A) => ({ params: { lang: A.locale.path || undefined }, props: { A } }));
}
const { A } = Astro.props;
const { t, locale: loc, categories, stats } = A;
const brand = t("site.brand");
const L = (x: { lang: string }) => (x.lang === loc.lang ? undefined : x.lang);

const ZIP = `${REPO_URL}/releases/latest/download/350-layout-compositions-images.zip`;
const ZIP_CLASSIC = `${REPO_URL}/releases/latest/download/100-layout-compositions-images.zip`;
const CREDIT = t("about.credit", { brand, repo: REPO_URL });
const license = `https://creativecommons.org/licenses/by/4.0/deed.${loc.cc}`;
const issues = `${REPO_URL}/issues`;
---
<Site A={A} path="about/" title={t("about.title")} description={t("about.description", { brand })}>
  <article class="xxd-prose about">
    <h1>{t("about.title")}</h1>
    <p class="about-lead">{t("about.lead", { cats: stats.categories, subs: stats.subs })}</p>

    <h2>{t("about.how")}</h2>
    <ol>
      <li set:html={t("about.how1", { atlas: loc.base })} />
      <li>{t("about.how2")}</li>
      <li set:html={t("about.how3")} />
      <li set:html={t("about.how4")} />
    </ol>

    <h2>{t("about.cats", { n: stats.categories })}</h2>
    <ul class="about-cats">
      {categories.map((c) => <li><a href={`${loc.base}?c=${c.slug}`} lang={L(c)}>{c.no} {c.name}</a><span>{t("js.count", { n: c.count })} · {c.range}</span></li>)}
    </ul>

    <h2>{t("about.download")}</h2>
    <ul>
      <li set:html={t("about.zip", { url: ZIP })} />
      <li set:html={t("about.zip100", { url: ZIP_CLASSIC })} />
      <li set:html={t("about.data", { csv: `${REPO_URL}/blob/main/v2/catalog.csv`, json: `${REPO_URL}/blob/main/v2/catalog.json` })} />
    </ul>

    <h2>{t("about.license")}</h2>
    <p set:html={t("about.licenseText", { license })} />
    <div class="about-credit">
      <p>{CREDIT}</p>
      <button class="xxd-btn" data-size="sm" type="button" data-copy={CREDIT} data-copy-done={t("detail.copied")}><i data-xxd-icon="Copy" data-size="16"></i>{t("about.copyCredit")}</button>
    </div>

    <h2>{t("about.text")}</h2>
    <p set:html={t("about.textBody", { issues })} />
    {loc !== SOURCE && <p set:html={t("about.translated", { issues })} />}

    <h2>{t("about.xxd")}</h2>
    <ul>
      <li set:html={t("about.source", { repo: REPO_URL })} />
      <li set:html={t("about.vip", { vip: "https://vip.xiaoxiaodong.ai/" })} />
      <li set:html={t("about.contact", { x: "https://x.com/xiaoxiaodong01" })} />
    </ul>
  </article>
</Site>
