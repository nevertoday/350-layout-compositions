---
// 一张海报：缩略图（3:4，懒加载，尺寸写死不跳）+ 名称和编号，整张可点；图的右上角（从右往左的语言是左上角）的星标是收藏（favs.js 接管）。
// 没有边框和底色，海报自己就是卡片。有互动版的，编号前面一个小手势图标。detail 为真时多写列表视图要的英文名、一句定义和分类名（图鉴页「显示 → 列表」用，别的视图藏起来）。
// lang：这一种的文字不是页面的语言时（译文缺这一种，用的中文）整张卡写上它的语言
interface Props {
  A: { locale: { base: string; lang: string }; t: (k: string, v?: Record<string, string>) => string };
  l: { id: string; name: string; nameEn: string; summary: string; guide?: { hook: string } | null; lang: string; play: string | null; img: { thumb: string } };
  cat?: { name: string; lang?: string };
  eager?: boolean;
  current?: boolean;
}
const { A, l, cat, eager = false, current = false } = Astro.props;
const other = (lang?: string) => (lang && lang !== A.locale.lang ? lang : undefined);
// 分类名的语言和这张卡（l.lang）不同时写上
const catLang = cat && (cat.lang ?? A.locale.lang) !== l.lang ? (cat.lang ?? A.locale.lang) : undefined;
const blurb = l.guide?.hook || l.summary;
---
<li class="atlas-card" data-id={l.id} lang={other(l.lang)}>
  <a class="atlas-card__link" href={`${A.locale.base}${l.id}/`} aria-current={current ? "page" : undefined}>
    <span class="atlas-card__media"><img src={l.img.thumb} width="480" height="640" alt="" loading={eager ? undefined : "lazy"} decoding="async" /></span>
    <span class="atlas-card__cap"><span class="atlas-card__name">{l.name}</span><span class="atlas-card__no">{l.play && <i data-xxd-icon="MousePointerClick" data-size="12" class="atlas-card__play" aria-label={A.t("atlas.play")}></i>}{l.id}</span></span>
    {cat && (
      <span class="atlas-card__more">
        {l.nameEn && l.nameEn !== l.name && <span class="atlas-card__en" lang="en">{l.nameEn}</span>}
        {blurb && <span class="atlas-card__sum">{blurb}</span>}
        <span class="atlas-card__cat" lang={catLang}>{cat.name}</span>
      </span>
    )}
  </a>
  <button class="atlas-fav" type="button" data-fav={l.id} data-name={l.name} aria-pressed="false" aria-label={A.t("js.fav.add", { name: l.name })}><i data-xxd-icon="Star" data-size="16"></i></button>
</li>
