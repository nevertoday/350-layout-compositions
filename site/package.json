{
  "name": "xxd-layout-site",
  "private": true,
  "license": "CC-BY-4.0",
  "description": "350 种排版的网站：找到一种版式、看清楚、拿去用。界面用 xxd-ui-kit。",
  "type": "module",
  "scripts": {
    "images": "node scripts/build-images.mjs",
    "dev": "npm run images && astro dev --port 4420",
    "build": "npm run images && astro build",
    "check": "node scripts/check-site.mjs",
    "check:browser": "node scripts/browser-check.mjs",
    "preview": "astro preview --port 4420",
    "release": "npm run build && npm run check && wrangler deploy"
  },
  "dependencies": {
    "astro": "7.2.8"
  },
  "devDependencies": {
    "wrangler": "4.127.1"
  }
}
