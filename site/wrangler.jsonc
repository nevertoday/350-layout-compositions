// 350 种排版的网站，部署到 Cloudflare（纯静态，Workers 静态资源）：https://layout.xiaoxiaodong.ai
// 部署：npm run release（生成图片、构建、检查，再 wrangler deploy）
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xxd-layout-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "layout.xiaoxiaodong.ai", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
}
